// CMS platform — data model.
// Phase 1: multi-tenant foundation (User, Site, Deployment). Collection is
// now built (converted-site CMS Collections — see Collection/CollectionItem
// below). Remaining CMS content entities (Page, BlogPost, Media, Nav, Forms,
// Seo, Settings, Domain) are added in their respective phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SiteStatus {
  draft
  converting
  ready
  published
  error
}

enum DeployStatus {
  queued
  building
  ready
  error
}

/// A platform user. `id` is the Supabase Auth user UUID; the password and
/// email verification live in Supabase's auth schema. This row is upserted on
/// first authenticated request so app data (Sites) can FK to it.
model User {
  id        String   @id
  email     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites Site[]
}

/// A converted website owned by a user. Root of all per-site CMS data, so
/// every CMS record is isolated by `siteId` (+ ownership checks in the app).
model Site {
  id         String     @id @default(cuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  framerUrl  String
  /// "hybrid" (default converter) or "nextjs" (pure Next.js export).
  outputKind String     @default("hybrid")
  /// Reference to the imported design bundle in Blob (the converter output job id).
  themeRef   String?
  status     SiteStatus @default(draft)
  /// Netlify build hook URL used by "Publish" to trigger a rebuild.
  buildHook  String?
  /// Visual-editor unpublished draft: an EditorEdit[] captured in the editor,
  /// applied to the bundle + pushed live on Publish.
  draftEdits Json?
  /// Studio (Framer-style canvas) page tree — a DesignDoc of JSON component
  /// trees, edited as blocks on artboards. Independent of the converted bundle.
  designTree Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  deployments Deployment[]
  collections Collection[]

  @@index([ownerId])
  @@index([status])
}

/// A Framer CMS Collection detected in a converted site's original bundle
/// (e.g. a blog's N post pages sharing one template) — see
/// lib/collections-detect.ts. `templateSourcePath` points into the immutable
/// original bundle (Site.themeRef -> lib/store.ts's job store), never copied
/// here, so the template stays the single source of truth. Item content
/// lives in CollectionItem rows below; publish re-renders the template with
/// current item field values (lib/collections-render.ts).
model Collection {
  id                  String   @id @default(cuid())
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                String
  /// e.g. "/blog" — the shared parent path of every item route.
  routePrefix         String
  /// report.files[] path (in the original bundle) the template markup is
  /// re-read from at publish/preview time.
  templateSourcePath  String
  /// FieldSlot[] — see lib/collections-detect.ts.
  fields              Json
  /// 0..1 structural-match confidence from detection (informational).
  confidence          Float    @default(0)
  /// e.g. "/blog" if a listing/index page exists for this collection.
  listingRoute        String?
  /// Set once listing-page repeater detection succeeds:
  /// { containerPath: number[], cardFields: FieldSlot[] }.
  listingCardTemplate Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items CollectionItem[]

  @@unique([siteId, routePrefix])
  @@index([siteId])
}

/// One item (e.g. a blog post) within a Collection. `fields` holds the
/// per-item content (Record<fieldKey, string>; richtext values are
/// sanitized HTML). Postgres rows ARE the draft state here — unlike
/// Site.draftEdits, there's no separate staging blob (see plan rationale:
/// item CRUD has its own lifecycle, publish is idempotent re-render).
model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  slug         String
  fields       Json
  /// Original route this item was seeded from at detection time; null for
  /// items created after conversion (added directly in the CMS).
  sourceRoute  String?
  /// Soft-delete for seeded items so publish knows to drop that file; items
  /// created post-conversion hard-delete instead.
  deleted      Boolean    @default(false)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([collectionId, slug])
  @@index([collectionId])
}

/// A blog post published on the marketing site (founders panel authors these).
/// Content is Markdown, rendered to HTML at request time.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  /// Markdown body.
  content     String
  coverImage  String?
  tags        String[]  @default([])
  /// "draft" or "published".
  status      String    @default("draft")
  authorName  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

/// A deployment of a site to a host (Netlify first).
model Deployment {
  id              String       @id @default(cuid())
  siteId          String
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider        String       @default("netlify")
  status          DeployStatus @default(queued)
  netlifyDeployId String?
  url             String?
  log             String?
  /// Provider-side target for redeploys: Netlify site id / Vercel project name.
  externalId      String?
  /// Vercel team/scope id the project was created under, if any (a personal
  /// account has none). Required on every redeploy, not just the first
  /// deploy — omitting it makes Vercel's API default to the token's personal
  /// scope, which silently creates/updates a DIFFERENT, orphaned project
  /// instead of the real one when the original deploy was team-scoped. Was
  /// missing here entirely: Publish always redeployed with no teamId, so any
  /// team-scoped Vercel project's live site never actually updated even
  /// though publish reported success. Netlify has no equivalent concept.
  teamId          String?
  /// User's deploy token, AES-256-GCM encrypted (lib/crypto.ts). Stored only
  /// when the user opts in ("save for AI edits"); enables the AI editor to
  /// push changes back to the same live site.
  tokenEnc        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([siteId, createdAt])
}

/// First-touch signup attribution, keyed by the Supabase auth user id.
/// Captured once at first sign-in (auth callback) — country from the CDN geo
/// header, source/referrer/UTM from a first-touch cookie set on landing.
model SignupMeta {
  userId      String   @id
  country     String?
  source      String?
  medium      String?
  campaign    String?
  referrer    String?
  landingPath String?
  /// Parsed from the User-Agent header at signup: "desktop" | "mobile" | "tablet".
  device      String?
  /// e.g. "Chrome", "Safari", "Firefox", "Edge". Best-effort UA sniffing —
  /// browsers that deliberately present as Chrome for compatibility (Arc,
  /// Brave in some configs) aren't distinguishable from the UA string alone.
  browser     String?
  /// e.g. "Windows", "macOS", "iOS", "Android", "Linux".
  os          String?
  createdAt   DateTime @default(now())
}

/// "Need help?" badge submissions (site-wide, bottom-right). Always stored
/// here regardless of whether email delivery is configured (RESEND_API_KEY)
/// — the DB row is the durable record; email is a best-effort notification
/// on top of it, not the source of truth.
model ContactMessage {
  id        String   @id @default(cuid())
  email     String
  message   String
  /// Page the badge was opened from, for context (e.g. "/dashboard").
  page      String?
  /// True once an email notification was successfully sent for this row.
  emailed   Boolean  @default(false)
  createdAt DateTime @default(now())
}
